{
  "info": {
    "name": "Car Dealership API",
    "_postman_id": "d5f15d37-8b37-4b68-8d95-8c1389609308",
    "description": "Colección para pruebas de la API de concesionaria. Incluye los endpoints principales y las validaciones actuales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "description": "Iniciar sesión. Validación: email válido, password obligatorio."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "description": "Solicitar recuperación de contraseña."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password/:token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password", ":token"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"newsecret123\"\n}"
            },
            "description": "Restablecer contraseña con token. Reemplazar :token por el token real."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Obtener la lista de cuentas de usuario. Requiere autorización."
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ana\",\n  \"email\": \"ana@example.com\",\n  \"password\": \"password1\",\n  \"status\": \"active\",\n  \"id_role\": 2\n}"
            },
            "description": "Crear usuario. Validaciones: first_name mínimo 2 letras, email válido, password mínimo 6 caracteres, id_role entero positivo."
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/:id",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ana María\",\n  \"email\": \"ana.maria@example.com\",\n  \"password\": \"newpass123\",\n  \"status\": \"active\",\n  \"id_role\": 2\n}"
            },
            "description": "Actualizar usuario. Reemplazar :id con el ID real."
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/users/:id",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id"]
            },
            "description": "Eliminar usuario por ID. Requiere rol de administrador."
          }
        }
      ]
    },
    {
