            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"John Updated\",\n  \"last_name\": \"Doe Updated\",\n  \"email\": \"john.updated@example.com\"\n}"
            },
            "description": "Actualizar los datos del usuario en sesión (nombre, apellido, email, password). El rol y estado no se pueden actualizar por seguridad."
          }
