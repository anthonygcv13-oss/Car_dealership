              "host": ["{{baseUrl}}"],
              "path": ["vehicles"]
            },
            "description": "Listar vehículos. Permite acceso a roles 1, 2 y 3."
          }
        },
        {
          "name": "Create Vehicle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vehicles",
              "host": ["{{baseUrl}}"],
              "path": ["vehicles"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand_id\": 1,\n  \"model_id\": 1,\n  \"year\": 2025,\n  \"price\": 25000,\n  \"kilometers\": 0\n}"
            },
            "description": "Crear vehículo. Requiere rol 1 o 2."
          }
        },
        {
          "name": "Update Vehicle",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vehicles/:id",
              "host": ["{{baseUrl}}"],
              "path": ["vehicles", ":id"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand_id\": 1,\n  \"model_id\": 1,\n  \"year\": 2025,\n  \"price\": 24500,\n  \"kilometers\": 10\n}"
            },
            "description": "Actualizar vehículo. Requiere rol 1 o 2."
          }
        },
        {
          "name": "Delete Vehicle",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/vehicles/:id",
              "host": ["{{baseUrl}}"],
              "path": ["vehicles", ":id"]
            },
            "description": "Eliminar vehículo. Solo rol 1."
          }
        }
      ]
    },
    {
      "name": "Vehicle Sales",
