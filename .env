# --- MODO DE EJECUCIÓN DE LA BASE DE DATOS ---
# Para usar PostgreSQL local, deja:
#   NODE_ENV=development
#   USE_LOCAL_DB=true
#
# Para usar Neon, deja:
#   NODE_ENV=production
#   USE_LOCAL_DB=false
#
# El backend elegirá automáticamente la URL correcta según estas variables.
NODE_ENV=production
USE_LOCAL_DB=false

# --- PUERTO DEL SERVIDOR ---
PORT=3000

# --- CONEXIÓN LOCAL (Formato URL para Sequelize) ---
# Estructura: postgres://usuario:password@host:puerto/nombre_bd
# Úsala cuando trabajes en desarrollo con PostgreSQL instalado localmente.
DATABASE_URL_LOCAL=postgres://postgres:1320@localhost:5432/cars

# --- CONEXIÓN NEON (NUBE) ---
# Úsala cuando quieras conectar el backend a Neon en producción o staging.
# Asegúrate de que la URL incluya sslmode=require (o verify-full según tu proyecto).
DATABASE_URL_NEON=postgresql://neondb_owner:npg_drUngS8L4teF@ep-frosty-pond-aml3ih7g-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=verify-full

